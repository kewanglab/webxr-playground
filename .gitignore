node_modules
dist
*.local
.DS_Store
logs/*.json
# Quarantined copies written by the dev log API when the store fails to parse.
logs/*.corrupt-*
# Half-written stores left behind if the dev server dies mid-write.
logs/*.tmp
tsconfig.tsbuildinfo

# Playwright run output — traces and error context written on failure, plus the
# HTML report if anyone runs with `--reporter=html`. Authored screenshots go to
# docs/mockups/captures/ instead and stay tracked.
test-results/
playwright-report/

# Cursor — keep shared rules, ignore local plans/metadata
.cursor/*
!.cursor/rules/
!.cursor/rules/**
.cursor/plans/

# Source asset packs — build-time inputs for `npm run build:xr-kit` only.
# Keep local licensed copies here; they are never served at runtime.
# See public/assets/README.md.
public/assets/models/Modular SciFi MegaKit[Standard]/
public/assets/models/Molten Maps SciFi Asset Pack/

# Derived kit GLBs. Untracked deliberately: they are derivatives of the packs
# above, whose redistribution terms are unresolved, and the site is public.
# `npm run build:xr-kit` regenerates them locally; nothing loads them today.
public/assets/models/xr-kit/
